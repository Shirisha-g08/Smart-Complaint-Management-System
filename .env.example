# ─────────────────────────────────────────────
# Smart Complaint Management System — .env
# Copy this file to .env and fill in real values
# ─────────────────────────────────────────────

# Flask
SECRET_KEY=7a1f9e3c2b6d4f8e9a0c1e5b7d3f2a8c6e9b4d1f0a5c7e8b2d6f9
FLASK_ENV=development

# AWS Credentials (use IAM role on EC2 instead of keys when possible)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=<modify_me>
AWS_SECRET_ACCESS_KEY=<modify_me>+

# DynamoDB Table Names
DYNAMODB_USERS_TABLE=scms_users
DYNAMODB_COMPLAINTS_TABLE=scms_complaints

# SNS — run aws/setup_aws.py to get this ARN
SNS_TOPIC_ARN=arn:aws:sns:*:*:scms-notifications

# Admin Credentials (change before deploying)
ADMIN_EMAIL=test@gmail.com
ADMIN_PASSWORD=Admin@123
